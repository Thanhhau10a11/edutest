# Server Configuration
PORT=5000
NODE_ENV=development

# MySQL Database Configuration
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=edutest_db
DB_USER=root
DB_PASSWORD=

# JWT Authentication
JWT_SECRET=edutest_jwt_secret_key_2026_secure
JWT_EXPIRES_IN=7d

# CORS Configuration (Client Origins)
CLIENT_URL=http://localhost:3000

# Gamification / Reward Settings
COINS_PER_CORRECT_ANSWER=10
POINTS_PER_CORRECT_ANSWER=5
BONUS_FULL_SCORE_COINS=50

# Gemini & Groq AI Integration
GEMINI_API_KEY=your_gemini_api_key_here
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=groq/compound-mini
